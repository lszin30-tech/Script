---------------------------------------------------------------- HITBOX / HITHEAD
local saved = setmetatable({}, {__mode = "k"})
local adorns = {}

local function expand(part, size, trans, color)
	if not saved[part] then
		saved[part] = {
			Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide,
			Massless = part.Massless, Color = part.Color, Material = part.Material,
		}
	end
	part.Size = size
	part.CanCollide = false
	part.Massless = true
	if trans then part.Transparency = trans end
	if color then
		part.Color = color
		part.Material = Enum.Material.Neon
	end
end

local function restore(part)
	local s = saved[part]
	if not s then return end
	pcall(function()
		part.Size = s.Size
		part.Transparency = s.Transparency
		part.CanCollide = s.CanCollide
		part.Massless = s.Massless
		part.Color = s.Color
		part.Material = s.Material
	end)
	saved[part] = nil
end

local function setSphere(head, on, radius, trans, color)
	local a = adorns[head]
	if on then
		if not a or not a.Parent then
			a = Instance.new("SphereHandleAdornment")
			a.AlwaysOnTop = true
			a.ZIndex = 1
			a.Adornee = head
			a.Parent = holder
			adorns[head] = a
		end
		a.Radius = radius
		a.Transparency = trans
		a.Color3 = color
	elseif a then
		a:Destroy()
		adorns[head] = nil
	end
end

local function hitStep()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			local c = p.Character
			if c then
				local hum = c:FindFirstChildOfClass("Humanoid")
				local root = c:FindFirstChild("HumanoidRootPart")
				local head = c:FindFirstChild("Head")
				local alive = hum and hum.Health > 0
				if root and root:IsA("BasePart") then
					if S.hbOn and alive and isEnemy(p, S.hbTeam) then
						expand(root, Vector3.new(S.hbW, S.hbH, S.hbW), S.hbTrans, col(S.hbColor))
					else
						restore(root)
					end
				end
				if head and head:IsA("BasePart") then
					if S.hhOn and alive and isEnemy(p, S.hhTeam) then
						local sz = S.hhSize
						expand(head, Vector3.new(sz, sz, sz), S.hhHide and 1 or nil, nil)
						setSphere(head, S.hhVisual, sz / 2, S.hhTrans, col(S.hhColor))
					else
						restore(head)
						setSphere(head, false)
					end
				end
			end
		end
	end
	for head, a in pairs(adorns) do
		if not head.Parent then
			a:Destroy()
			adorns[head] = nil
		end
	end
end

---------------------------------------------------------------- AIMBOT
local fovC = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
}, gui)
new("UICorner", {CornerRadius = UDim.new(1, 0)}, fovC)
local fovS = stroke(fovC, col(S.aimFovColor), 1.5)

local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude

local function screenCenter()
	if UIS.TouchEnabled and not UIS.MouseEnabled then
		local vp = getCam().ViewportSize
		return Vector2.new(vp.X / 2, vp.Y / 2)
	end
	return UIS:GetMouseLocation()
end

local function getAimPart(c)
	if S.aimPart == 1 then return c:FindFirstChild("Head")
	elseif S.aimPart == 2 then return c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso")
	else return c:FindFirstChild("HumanoidRootPart") end
end

local function aimStep()
	local cam = getCam()
	if not cam then return end
	local center = screenCenter()
	fovC.Visible = S.aimOn and S.aimShowFov
	if fovC.Visible then
		fovC.Size = UDim2.fromOffset(S.aimFov * 2, S.aimFov * 2)
		fovC.Position = UDim2.fromOffset(center.X, center.Y)
		fovS.Color = col(S.aimFovColor)
	end
	if not S.aimOn then return end
	if S.aimMode == 2 and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end

	if S.aimWall then
		local f = {cam}
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl.Character then f[#f + 1] = pl.Character end
		end
		rp.FilterDescendantsInstances = f
	end

	local origin = cam.CFrame.Position
	local best, bestD = nil, S.aimFov
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and isEnemy(p, S.aimTeam) then
			local c = getChar(p)
			if c then
				local part = getAimPart(c)
				if part and (part.Position - origin).Magnitude <= S.aimDist then
					local v, on = cam:WorldToViewportPoint(part.Position)
					if on then
						local d = (Vector2.new(v.X, v.Y) - center).Magnitude
						if d < bestD then
							local clear = true
							if S.aimWall then
								clear = Workspace:Raycast(origin, part.Position - origin, rp) == nil
							end
							if clear then bestD = d; best = part end
						end
					end
				end
			end
		end
	end
	if best then
		local pos = best.Position
		if S.aimPredOn then pos = pos + best.AssemblyLinearVelocity * S.aimPred end
		local goal = CFrame.new(origin, pos)
		cam.CFrame = cam.CFrame:Lerp(goal, math.clamp(S.aimSmooth / 100, 0.01, 1))
	end
end

---------------------------------------------------------------- ESP
local HAS_DRAW = false
pcall(function()
	local t = Drawing.new("Line")
	t:Remove()
	HAS_DRAW = true
end)

local espObjs, highlights = {}, {}

local function D(cls, props)
	local d = Drawing.new(cls)
	for k, v in pairs(props or {}) do d[k] = v end
	d.Visible = false
	return d
end

local function makeESP(p)
	local o = {all = {}, skel = {}, corner = {}}
	local function add(cls, props)
		local d = D(cls, props)
		o.all[#o.all + 1] = d
		return d
	end
	local black = Color3.new(0, 0, 0)
	o.fill = add("Square", {Filled = true})
	o.boxOut = add("Square", {Filled = false, Thickness = 3, Color = black})
	o.box = add("Square", {Filled = false, Thickness = 1})
	for i = 1, 8 do o.corner[i] = add("Line", {Thickness = 2}) end
	o.name = add("Text", {Center = true, Outline = true, Font = 2})
	o.dist = add("Text", {Center = true, Outline = true, Font = 2})
	o.weapon = add("Text", {Center = true, Outline = true, Font = 2})
	o.hpBg = add("Square", {Filled = true, Color = black})
	o.hp = add("Square", {Filled = true})
	o.hpTxt = add("Text", {Center = true, Outline = true, Font = 2})
	o.tracer = add("Line", {Thickness = 1})
	o.headDot = add("Circle", {Thickness = 1, NumSides = 24, Filled = false})
	o.arrow = add("Triangle", {Filled = true})
	for i = 1, 14 do o.skel[i] = add("Line", {Thickness = 1}) end
	espObjs[p] = o
	return o
end

local function hideESP(o)
	for _, d in ipairs(o.all) do d.Visible = false end
end

local R15 = {
	{"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
	{"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
	{"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
	{"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
	{"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
}
local R6 = {
	{"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
	{"Torso", "Left Leg"}, {"Torso", "Right Leg"},
}

local function updateChams(p, c, show, color)
	local hl = highlights[p]
	if show and S.espChams then
		if not hl or not hl.Parent then
			hl = Instance.new("Highlight")
			hl.Parent = holder
			highlights[p] = hl
		end
		hl.Adornee = c
		hl.FillColor = color
		hl.OutlineColor = Color3.new(1, 1, 1)
		hl.FillTransparency = S.espChamsFill
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	elseif hl then
		hl:Destroy()
		highlights[p] = nil
	end
end

local function drawPlayer(o, p, c, hum, root, cam, vp, center, color, dist)
	local rv, on = cam:WorldToViewportPoint(root.Position)
	if on and rv.Z > 0 then
		local top = cam:WorldToViewportPoint(root.Position + Vector3.new(0, 2.7, 0))
		local bot = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3.1, 0))
		local h = math.abs(top.Y - bot.Y)
		local w = h * 0.55
		local x, y = rv.X - w / 2, math.min(top.Y, bot.Y)

		if S.espFill then
			o.fill.Position = Vector2.new(x, y); o.fill.Size = Vector2.new(w, h)
			o.fill.Color = color; o.fill.Transparency = S.espFillOp; o.fill.Visible = true
		end
		if S.espBox then
			if S.espBoxStyle == 1 then
				o.boxOut.Position = Vector2.new(x, y); o.boxOut.Size = Vector2.new(w, h); o.boxOut.Visible = true
				o.box.Position = Vector2.new(x, y); o.box.Size = Vector2.new(w, h)
				o.box.Color = color; o.box.Visible = true
			else
				local len = math.min(w, h) * 0.3
				local pts = {
					{Vector2.new(x, y), Vector2.new(x + len, y)}, {Vector2.new(x, y), Vector2.new(x, y + len)},
					{Vector2.new(x + w, y), Vector2.new(x + w - len, y)}, {Vector2.new(x + w, y), Vector2.new(x + w, y + len)},
					{Vector2.new(x, y + h), Vector2.new(x + len, y + h)}, {Vector2.new(x, y + h), Vector2.new(x, y + h - len)},
					{Vector2.new(x + w, y + h), Vector2.new(x + w - len, y + h)}, {Vector2.new(x + w, y + h), Vector2.new(x + w, y + h - len)},
				}
				for i, pt in ipairs(pts) do
					local l = o.corner[i]
					l.From = pt[1]; l.To = pt[2]; l.Color = color; l.Visible = true
				end
			end
		end

		local ts = S.espTextSize
		if S.espName then
			o.name.Text = p.DisplayName; o.name.Size = ts; o.name.Color = color
			o.name.Position = Vector2.new(rv.X, y - ts - 3); o.name.Visible = true
		end
		local yy = y + h + 2
		if S.espDist then
			o.dist.Text = string.format("[%dm]", dist); o.dist.Size = ts
			o.dist.Color = Color3.new(1, 1, 1)
			o.dist.Position = Vector2.new(rv.X, yy); o.dist.Visible = true
			yy = yy + ts + 1
		end
		if S.espWeapon then
			local tool = c:FindFirstChildOfClass("Tool")
			o.weapon.Text = tool and tool.Name or "—"; o.weapon.Size = ts
			o.weapon.Color = Color3.fromRGB(255, 205, 0)
			o.weapon.Position = Vector2.new(rv.X, yy); o.weapon.Visible = true
		end
		if S.espHealth then
			local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
			local hc = Color3.fromRGB(255, 40, 50):Lerp(Color3.fromRGB(255, 205, 0), pct)
			o.hpBg.Position = Vector2.new(x - 7, y - 1); o.hpBg.Size = Vector2.new(5, h + 2); o.hpBg.Visible = true
			o.hp.Position = Vector2.new(x - 6, y + h * (1 - pct)); o.hp.Size = Vector2.new(3, h * pct)
			o.hp.Color = hc; o.hp.Visible = true
			o.hpTxt.Text = tostring(math.floor(hum.Health)); o.hpTxt.Size = math.max(ts - 2, 9)
			o.hpTxt.Color = hc
			o.hpTxt.Position = Vector2.new(x - 20, y + h * (1 - pct) - 5); o.hpTxt.Visible = true
		end
		if S.espTracer then
			local from
			if S.espTracerFrom == 1 then from = Vector2.new(center.X, vp.Y)
			elseif S.espTracerFrom == 2 then from = center
			else from = Vector2.new(center.X, 0) end
			o.tracer.From = from; o.tracer.To = Vector2.new(rv.X, y + h)
			o.tracer.Color = color; o.tracer.Visible = true
		end
		if S.espHead then
			local head = c:FindFirstChild("Head")
			if head then
				local hp = cam:WorldToViewportPoint(head.Position)
				o.headDot.Position = Vector2.new(hp.X, hp.Y)
				o.headDot.Radius = math.max(h * 0.08, 2)
				o.headDot.Color = color; o.headDot.Visible = true
			end
		end
		if S.espSkeleton then
			local list = c:FindFirstChild("UpperTorso") and R15 or R6
			for i, pair in ipairs(list) do
				local a, b = c:FindFirstChild(pair[1]), c:FindFirstChild(pair[2])
				local l = o.skel[i]
				if a and b and l then
					local pa = cam:WorldToViewportPoint(a.Position)
					local pb = cam:WorldToViewportPoint(b.Position)
					if pa.Z > 0 and pb.Z > 0 then
						l.From = Vector2.new(pa.X, pa.Y); l.To = Vector2.new(pb.X, pb.Y)
						l.Color = color; l.Visible = true
					end
				end
			end
		end
	elseif S.espArrow then
		local pos = Vector2.new(rv.X, rv.Y)
		if rv.Z < 0 then pos = center * 2 - pos end
		local dir = pos - center
		if dir.Magnitude > 1 then
			dir = dir.Unit
			local base = center + dir * S.espArrowR
			local perp = Vector2.new(-dir.Y, dir.X)
			o.arrow.PointA = base + dir * 14
			o.arrow.PointB = base + perp * 9
			o.arrow.PointC = base - perp * 9
			o.arrow.Color = color; o.arrow.Visible = true
		end
	end
end

local function espStep()
	local cam = getCam()
	if not cam then return end
	local vp = cam.ViewportSize
	local center = vp / 2
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			local o = HAS_DRAW and (espObjs[p] or makeESP(p)) or nil
			if o then hideESP(o) end
			local c, hum, root = getChar(p)
			local show = S.espOn and c ~= nil and isEnemy(p, S.espTeam)
			local dist = 0
			if show then
				dist = (root.Position - cam.CFrame.Position).Magnitude
				if dist > S.espMaxDist then show = false end
			end
			local color = (S.espTeamColor and p.Team) and p.TeamColor.Color or col(S.espColor)
			updateChams(p, c, show, color)
			if show and o then
				drawPlayer(o, p, c, hum, root, cam, vp, center, color, dist)
			end
		end
	end
end

local function dropESP(p)
	local o = espObjs[p]
	if o then
		for _, d in ipairs(o.all) do pcall(function() d:Remove() end) end
		espObjs[p] = nil
	end
	if highlights[p] then
		highlights[p]:Destroy()
		highlights[p] = nil
	end
end
track(Players.PlayerRemoving:Connect(dropESP))

---------------------------------------------------------------- TROLL
local flyBV, flyBG
local flyUp, flyDown = false, false
local wsApplied, jpApplied, gravApplied, fovApplied = false, false, false, false
local origWS, origJP
local origGrav = Workspace.Gravity

local function flyClean()
	if flyBV then flyBV:Destroy() flyBV = nil end
	if flyBG then flyBG:Destroy() flyBG = nil end
	local ch = LP.Character
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	if h then h.PlatformStand = false end
end

local function movStep(dt)
	if S.gravOn then
		Workspace.Gravity = S.gravity
		gravApplied = true
	elseif gravApplied then
		Workspace.Gravity = origGrav
		gravApplied = false
	end

	local char = LP.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return end
	local cam = getCam()

	-- voar
	if S.flyOn then
		if not flyBV or flyBV.Parent ~= root then
			flyClean()
			flyBV = Instance.new("BodyVelocity")
			flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
			flyBV.Velocity = Vector3.zero
			flyBV.Parent = root
			flyBG = Instance.new("BodyGyro")
			flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
			flyBG.P = 9e4
			flyBG.Parent = root
		end
		hum.PlatformStand = true
		local md = hum.MoveDirection
		local look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
		local fl = Vector3.new(look.X, 0, look.Z)
		local fr = Vector3.new(right.X, 0, right.Z)
		fl = fl.Magnitude > 0 and fl.Unit or Vector3.zero
		fr = fr.Magnitude > 0 and fr.Unit or Vector3.zero
		local vel = look * md:Dot(fl) + right * md:Dot(fr)
		local up = flyUp or UIS:IsKeyDown(Enum.KeyCode.Space)
		local down = flyDown or UIS:IsKeyDown(Enum.KeyCode.LeftControl)
		vel = vel + Vector3.new(0, (up and 1 or 0) - (down and 1 or 0), 0)
		flyBV.Velocity = vel * S.flySpeed
		flyBG.CFrame = cam.CFrame
	elseif flyBV then
		flyClean()
	end

	-- velocidade
	if S.speedOn and not S.flyOn then
		local md = hum.MoveDirection
		if S.speedMode == 1 then
			if md.Magnitude > 0 then
				local v = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = Vector3.new(md.X * S.speed, v.Y, md.Z * S.speed)
			end
		elseif S.speedMode == 2 then
			if md.Magnitude > 0 then root.CFrame = root.CFrame + md * S.speed * dt end
		end
	end
	if S.speedOn and S.speedMode == 3 then
		if not wsApplied then origWS = hum.WalkSpeed; wsApplied = true end
		hum.WalkSpeed = S.speed
	elseif wsApplied then
		hum.WalkSpeed = origWS or 16
		wsApplied = false
	end

	-- pulo
	if S.jumpOn then
		if not jpApplied then origJP = hum.JumpPower; jpApplied = true end
		hum.UseJumpPower = true
		hum.JumpPower = S.jump
	elseif jpApplied then
		hum.JumpPower = origJP or 50
		jpApplied = false
	end

	-- girar
	if S.spinOn and not S.flyOn then
		root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(S.spinSpeed * dt), 0)
	end
end

