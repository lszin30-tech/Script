local lightOrig
local function lightRestore()
	if lightOrig then
		pcall(function()
			Lighting.Brightness = lightOrig.B; Lighting.GlobalShadows = lightOrig.G
			Lighting.Ambient = lightOrig.A; Lighting.FogEnd = lightOrig.F; Lighting.ClockTime = lightOrig.T
		end)
		lightOrig = nil
	end
end
