local function tpNext()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then list[#list + 1] = p.Name end
	end
	table.sort(list)
	if #list == 0 then S.tpName = "—" return end
	local idx = table.find(list, S.tpName) or 0
	S.tpName = list[idx % #list + 1]
end

